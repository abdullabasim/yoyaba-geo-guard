####################################################################
# YOYABA GEO Guard — environment configuration
#
# This file is consumed by docker-compose.yml and, when running
# locally, by pydantic-settings (backend/app/core/config.py).
#
# Copy to `.env` and fill in the real secrets. Never commit secrets.
####################################################################

# ------------------------------------------------------------------
# General
# ------------------------------------------------------------------
# Free-form environment label: local | staging | production
APP_ENV=local
# Enables FastAPI /docs and verbose tracebacks. Set false in production.
DEBUG=true
# Python log level for backend + worker: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_USER=seo
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=seo_intent
# Hostname as seen from inside the Docker network (compose service name).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port mapping — deliberately non-default to avoid dev collisions.
POSTGRES_HOST_PORT=55432

# Async driver URL used by FastAPI, Celery workers and Alembic.
# Inside Docker: postgresql+asyncpg://seo:...@postgres:5432/seo_intent
# Running locally against the compose DB, use 127.0.0.1:55432 instead.
DATABASE_URL=postgresql+asyncpg://seo:change-me-postgres@postgres:5432/seo_intent

# ------------------------------------------------------------------
# Redis (Celery broker + result backend)
# ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=56379
# Separate logical DBs so broker and results never clash.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Seeded on first backend start if no user exists yet.
FIRST_ADMIN_EMAIL=admin@yoyaba.com
FIRST_ADMIN_PASSWORD=Yyba-x8F2-mP9q-L5k1

# ------------------------------------------------------------------
# Demo data
# ------------------------------------------------------------------
# Seed a realistic demo hierarchy (real live URLs, plausible keywords) on first
# start. Skipped entirely when the database already contains any client, so a
# restart never duplicates or overwrites real data. Set false for production.
SEED_DEMO_DATA=false
# Generate ~45 days of backdated ranking history for the demo keywords, including
# one engineered rank drop per project so the chart and the AI trigger have
# something to show. Fully offline: no SERP provider calls, no cost.
SEED_DEMO_HISTORY=false

# ------------------------------------------------------------------
# DataForSEO (SERP provider)
# ------------------------------------------------------------------
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Force mocking even if credentials exist (saves money while developing).
DATAFORSEO_MOCK=false
# Number of keywords sent per single API call. Valid range 1–100.
DATAFORSEO_BATCH_SIZE=10
# Number of organic results requested per call (>=10, snapshot keeps top 10).
DATAFORSEO_DEPTH=100
DATAFORSEO_TIMEOUT_SECONDS=60

# ---- Rate control -------------------------------------------------
# Beat expands every due URL into one task per keyword and enqueues them
# together, so without pacing a nightly batch of 200 keywords fires as one burst
# and earns HTTP 429s. These limits are enforced in Redis (DB 3) and are
# therefore shared across all worker processes.
DATAFORSEO_MAX_REQUESTS_PER_MINUTE=60
DATAFORSEO_MAX_CONCURRENT_REQUESTS=5
# Hard ceiling per UTC day. 0 = unlimited.
DATAFORSEO_DAILY_REQUEST_BUDGET=0
DATAFORSEO_RATE_LIMIT_MAX_WAIT_SECONDS=30
DATAFORSEO_RATE_LIMIT_RETRY_DELAY_SECONDS=120
DATAFORSEO_RATE_LIMIT_MAX_RETRIES=5
DATAFORSEO_RATE_LIMIT_PENALTY_SECONDS=60
RATE_LIMIT_REDIS_DB=3

# ------------------------------------------------------------------
# OpenAI API Settings
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3

# ------------------------------------------------------------------
# LangSmith (LLM observability)
# ------------------------------------------------------------------
# When false or when the API key is empty, tracing decorators become no-ops.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=seo-intent-shift

# ------------------------------------------------------------------
# Slack
# ------------------------------------------------------------------
# Business alerts (intent shift detected).
# MASTER SWITCH for all Slack delivery. Set false while testing: no HTTP request
# is made to Slack at all, whatever the webhook URLs below say. Alerts are still
# classified, formatted, stored in the database and written to the log, so the
# whole pipeline is testable without filling a real channel with generated data.
# Flip to true when you are ready to go live.
SLACK_ENABLED=true
# Business alerts (intent shift detected). Independent of error alerts so a noisy
# customer channel can be silenced without going blind to system failures.
SLACK_BUSINESS_ALERTS_ENABLED=true
# Log the complete payload that WOULD have been sent while delivery is off. This
# is what makes testing with SLACK_ENABLED=false useful rather than opaque.
SLACK_LOG_SUPPRESSED_MESSAGES=true
SLACK_WEBHOOK_ALERTS=https://hooks.slack.com/services/XXX/YYY/ZZZ
# System failures. Falls back to SLACK_WEBHOOK_ALERTS when left empty.
SLACK_WEBHOOK_ERRORS=

# ------------------------------------------------------------------
# Error alerting (operator notifications)
# ------------------------------------------------------------------
# Master switch for error alerts. Business alerts are unaffected by this.
ERROR_ALERTS_ENABLED=true
# Quiet period in seconds per (error category, scope). Systemic failures such as
# a dead database or an exhausted quota use 3x this value. Without throttling a
# single upstream outage would post one Slack message per due keyword.
ALERT_THROTTLE_SECONDS=900
# How often the health monitor probes PostgreSQL, Redis and credentials. This is
# what catches an outage when no check happens to be scheduled.
HEALTH_CHECK_INTERVAL_SECONDS=300
# Alert when an API request fails because of a database error.
ALERT_ON_API_DATABASE_ERRORS=true
# Logical Redis DB holding alert de-duplication state. Kept separate from the
# Celery broker (0) and result backend (1).
ALERT_STATE_REDIS_DB=2

# ------------------------------------------------------------------
# Business rules
# ------------------------------------------------------------------
# A rank increase of this many positions or more triggers AI analysis.
RANK_DROP_THRESHOLD=3
# How often Celery Beat looks for due URLs, in seconds.
BEAT_DISPATCH_INTERVAL_SECONDS=300
# Grace window: a URL whose execution_time falls within this many minutes
# of "now" is considered due.
DUE_WINDOW_MINUTES=30

# ------------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:3100
FRONTEND_HOST_PORT=3100
BACKEND_HOST_PORT=8100
# Consumed by Next.js at build+runtime (must be reachable from the browser).
NEXT_PUBLIC_API_URL=http://localhost:8100
# Used by Next.js server components inside the Docker network.
INTERNAL_API_URL=http://backend:8000

# ------------------------------------------------------------------
# MCP server
# ------------------------------------------------------------------
MCP_SERVER_NAME=seo-intent-db
MCP_HOST_PORT=8110
